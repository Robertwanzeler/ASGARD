{
  "scenario_id": "greenran_fixed_baseline_v1",
  "ns3": {
    "scenario_binary_pattern": "scenario-greenran",
    "total_ues": 20,
    "camera_imsis": [1, 2, 3],
    "sensor_imsi_range": [4, 15],
    "background_imsi_range": [4, 15],
    "s1u_datarate_mbps": 15,
    "s1u_delay_ms": 5,
    "p2p_datarate_mbps": 30,
    "p2p_delay_ms": 20,
    "rlc_pdcp_buffer_mb": 20,
    "camera_off_time_s": 3,
    "background_on_time_s": 1,
    "background_off_time_s": 10
  },
  "apps": {
    "app1": {
      "domain": "camera",
      "active_cameras": 3,
      "throughput_target_mbps": 25,
      "throughput_warning_mbps": 30,
      "latency_warning_ms": 60,
      "latency_violation_ms": 80
    },
    "app2": {"domain": "sensor", "sensor_imsi_range": [4, 15], "delivery_target_percent": 95, "packet_loss_limit_percent": 5, "latency_limit_ms": 500},
    "app3": {
      "domain": "vehicle",
      "max_vehicles": 5,
      "vehicle_imsi_range": [16, 20],
      "base_imsi": 16
    }
  },
  "mapping": {
    "app1_slice_profile": "eMBB-like",
    "app2_slice_profile": "mMTC-like",
    "app3_slice_profile": "URLLC-like"
  },
  "invariants": {
    "keep_greenran_architecture": true,
    "keep_armd_greenran": true,
    "freeze_camera_vehicle_ue_counts": true
  },
  "marl": {
    "topology_id": "greenran_fixed_marl_v1",
    "logical_du_count": 3,
    "logical_dus": [
      {
        "du_id": "du_camera_edge",
        "role": "camera_edge",
        "primary_slice": "eMBB",
        "camera_imsis": [1, 2, 3],
        "background_imsis": [4, 5, 6],
        "slice_mix": {"eMBB": 0.85, "mMTC": 0.1, "URLLC": 0.05}
      },
      {
        "du_id": "du_sensor_mixed",
        "role": "sensor_mixed",
        "primary_slice": "mMTC",
        "background_imsis": [7, 8, 9],
        "slice_mix": {"eMBB": 0.35, "mMTC": 0.55, "URLLC": 0.1}
      },
      {
        "du_id": "du_vehicle_edge",
        "role": "vehicle_edge",
        "primary_slice": "URLLC",
        "background_imsis": [10, 11, 12, 13, 14, 15],
        "vehicle_imsi_range": [16, 20],
        "slice_mix": {"eMBB": 0.2, "mMTC": 0.15, "URLLC": 0.65}
      }
    ],
    "slice_profiles": {
      "eMBB": {"app": "app1", "domain": "camera", "qos_target": "throughput"},
      "mMTC": {"app": "app2", "domain": "sensor", "qos_target": "delivery"},
      "URLLC": {"app": "app3", "domain": "vehicle", "qos_target": "latency"}
    }
  }
}

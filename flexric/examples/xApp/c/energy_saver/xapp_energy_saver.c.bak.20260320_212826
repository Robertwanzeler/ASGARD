#define CONTROL_RETRY_MAX 3

static sm_ans_xapp_t send_control_with_retry(global_e2_node_id_t* node_id, rc_ctrl_req_data_t* ctrl)
{
    sm_ans_xapp_t result = {.success = false};
    
    for (int attempt = 1; attempt <= CONTROL_RETRY_MAX; attempt++) {
        printf("[XAPP-ENERGY] CONTROL: Attempt %d/%d...\n", attempt, CONTROL_RETRY_MAX);
        result = control_sm_xapp_api(node_id, SM_RC_ID, ctrl);
        
        if (result.success) {
            printf("[XAPP-ENERGY] CONTROL: Sucesso no attempt %d\n", attempt);
            return result;
        }
        
        printf("[XAPP-ENERGY] CONTROL: Falhou (timeout), retry em 2 segundos...\n");
        if (attempt < CONTROL_RETRY_MAX) {
            sleep(2);
        }
    }
    
    printf("[XAPP-ENERGY] AVISO: Todas as tentativas de controle falharam\n");
    return result;
}

static void send_intervention_control(uint64_t ue_id, uint16_t cell_id)
{
  printf("\n");
  printf("[XAPP-ENERGY] ==============================================\n");
  printf("[XAPP-ENERGY] ENVIANDO CONTROLE: INTERVENTION (CELL_ON)\n");
  printf("[XAPP-ENERGY] Celula alvo: %d\n", cell_id);
  printf("[XAPP-ENERGY] UE alvo: %lu\n", ue_id);
  printf("[XAPP-ENERGY] Razao: Latencia > threshold detectada\n");
  printf("[XAPP-ENERGY] Acao: MANTER CELULA ATIVA\n");
  printf("[XAPP-ENERGY] ==============================================\n");

  rc_ctrl_req_data_t rc_ctrl = {0};
  ue_id_e2sm_t ue_id_e2sm = {0};
  ue_id_e2sm.type = GNB_UE_ID_E2SM;
  ue_id_e2sm.gnb.ran_ue_id = malloc(sizeof(uint64_t));
  *(ue_id_e2sm.gnb.ran_ue_id) = ue_id;

  rc_ctrl.hdr = gen_rc_ctrl_hdr(FORMAT_1_E2SM_RC_CTRL_HDR, ue_id_e2sm, ENERGY_STATE, CELL_ON);
  char cell_char = '0' + (cell_id % 10);
  rc_ctrl.msg = gen_cell_trigger_rc_ctrl_msg(FORMAT_1_E2SM_RC_CTRL_MSG, cell_char);

  int64_t start = time_now_us();
  sm_ans_xapp_t ans = send_control_with_retry(g_target_node, &rc_ctrl);
  int64_t elapsed = time_now_us() - start;

  if (ans.success) {
    printf("[XAPP-ENERGY] CONTROL ENVIADO COM SUCESSO!\n");
    printf("[XAPP-ENERGY] Latencia de resposta: %ld us\n", elapsed);
    g_xapp_state.total_actions_sent++;
  } else {
    printf("[XAPP-ENERGY] ERRO: Falha ao enviar controle (apos %d tentativas)\n", CONTROL_RETRY_MAX);
    g_xapp_state.total_actions_failed++;
  }
  printf("[XAPP-ENERGY] Total enviado: %u | Falhas: %u\n",
         g_xapp_state.total_actions_sent, g_xapp_state.total_actions_failed);
  printf("[XAPP-ENERGY] ==============================================\n\n");

  free_ue_id_e2sm(&ue_id_e2sm);
  free_rc_ctrl_req_data(&rc_ctrl);
}


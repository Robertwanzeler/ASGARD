static void init_control_state(void)
{
    memset(&g_xapp_state, 0, sizeof(g_xapp_state));
    g_xapp_state.current_state = STATE_NORMAL;
    g_xapp_state.previous_state = STATE_NORMAL;
    g_xapp_state.running = true;
    g_xapp_state.control_enabled = true;
    g_xapp_state.num_cells = 0;
    
    for (int i = 0; i < MAX_CELLS; i++) {
        g_xapp_state.cells[i].cell_id = 0;
        g_xapp_state.cells[i].state = STATE_NORMAL;
        g_xapp_state.cells[i].last_state_change = 0;
        g_xapp_state.cells[i].has_valid_ue = false;
        g_xapp_state.cells[i].last_latency = 0;
        g_xapp_state.cells[i].last_bitrate = 0;
        g_xapp_state.cells[i].last_volume = 0;
    }
    
    printf("[XAPP-ENERGY] Estado de controle inicializado\n");
}

static void update_cell_state(int cell_idx, uint64_t ue_id, double latency, double bitrate, long volume)
{
    if (cell_idx < 0 || cell_idx >= MAX_CELLS)
        return;
    
    cell_control_state_t* cell = &g_xapp_state.cells[cell_idx];
    cell->ue_id = ue_id;
    cell->has_valid_ue = true;
    cell->last_latency = latency;
    cell->last_bitrate = bitrate;
    cell->last_volume = volume;
    
    system_state_e new_state = STATE_NORMAL;
    
    if (latency >= g_threshold_us) {
        new_state = STATE_INTERVENTION;
    } else if (volume < 100 && latency < g_threshold_us) {
        new_state = STATE_ENERGY_SAVE;
    }
    
    if (new_state != cell->state) {
        cell->previous_state = cell->state;
        cell->state = new_state;
        cell->last_state_change = time_now_us() / 1000000;
        
        printf("[XAPP-ENERGY] Cell %d mudou estado: %d -> %d (lat=%.0fus, vol=%ld)\n",
               cell->cell_id, cell->previous_state, new_state, latency, volume);
    }
}

static system_state_e aggregate_system_state(void)
{
    system_state_e worst_state = STATE_NORMAL;
    
    for (int i = 0; i < MAX_CELLS; i++) {
        if (g_xapp_state.cells[i].has_valid_ue) {
            if (g_xapp_state.cells[i].state == STATE_INTERVENTION) {
                return STATE_INTERVENTION;
            }
            if (g_xapp_state.cells[i].state == STATE_ENERGY_SAVE) {
                worst_state = STATE_ENERGY_SAVE;
            }
        }
    }
    
    return worst_state;
}

static int find_cell_needing_control(system_state_e target_state)
{
    for (int i = 0; i < MAX_CELLS; i++) {
        if (g_xapp_state.cells[i].has_valid_ue && 
            g_xapp_state.cells[i].state == target_state) {
            return i;
        }
    }
    return -1;
}

typedef struct {
  uint64_t ue_id;

  bool has_volume;
  bool has_pkts;
  bool has_bitrate;
  bool has_delay;

  long volume_dl;
  long pacotes_dl;
  long bitrate_dl_kbps;
  long delay_dl_us;

  uint64_t last_seen;
} ue_kpm_state_t;

static ue_kpm_state_t g_ue_kpm[MAX_UE_KPM_STATE];
static pthread_mutex_t g_ue_kpm_mtx = PTHREAD_MUTEX_INITIALIZER;

static uint64_t now_ms_kpm(void)
{
  struct timespec ts;
  clock_gettime(CLOCK_REALTIME, &ts);
  return (uint64_t)ts.tv_sec * 1000ULL + (uint64_t)(ts.tv_nsec / 1000000ULL);
}

static ue_kpm_state_t* get_or_create_ue_state(uint64_t ue_id)
{
  ue_kpm_state_t* free_slot = NULL;

  for (int i = 0; i < MAX_UE_KPM_STATE; ++i) {
    if (g_ue_kpm[i].ue_id == ue_id)
      return &g_ue_kpm[i];
    if (g_ue_kpm[i].ue_id == 0 && free_slot == NULL)
      free_slot = &g_ue_kpm[i];
  }

  if (free_slot != NULL) {
    free_slot->ue_id = ue_id;
    free_slot->last_seen = now_ms_kpm();
    return free_slot;
  }

  return NULL;
}

static bool ue_metrics_ready(const ue_kpm_state_t* s)
{
  return s != NULL &&
         s->has_volume &&
         s->has_pkts &&
         s->has_bitrate &&
         s->has_delay;
}

static void reset_ue_metric_flags(ue_kpm_state_t* s)
{
  if (s == NULL) return;
  s->has_volume = false;
  s->has_pkts = false;
  s->has_bitrate = false;
  s->has_delay = false;
}

static void upsert_ue_metric_i(uint64_t ue_id, const char* meas_name, long value)
{
  if (meas_name == NULL || ue_id == 0)
    return;

  pthread_mutex_lock(&g_ue_kpm_mtx);

  ue_kpm_state_t* s = get_or_create_ue_state(ue_id);
  if (s == NULL) {
    pthread_mutex_unlock(&g_ue_kpm_mtx);
    return;
  }

  s->last_seen = now_ms_kpm();

  if (strstr(meas_name, "DRB.PdcpSduVolumeDl") != NULL) {
    s->volume_dl = value;
    s->has_volume = true;
  } else if (strstr(meas_name, "Tot.PdcpSduNbrDl") != NULL) {
    s->pacotes_dl = value;
    s->has_pkts = true;
  } else if (strstr(meas_name, "DRB.PdcpSduBitRateDl") != NULL) {
    s->bitrate_dl_kbps = value;
    s->has_bitrate = true;
  } else if (strstr(meas_name, "DRB.PdcpSduDelayDl") != NULL) {
    s->delay_dl_us = value;
    s->has_delay = true;
  }

  pthread_mutex_unlock(&g_ue_kpm_mtx);
}

static bool snapshot_ue_if_ready_i(uint64_t ue_id,
                                   long* volume_dl,
                                   long* pacotes_dl,
                                   long* bitrate_dl_kbps,
                                   long* delay_dl_us)
{
  bool ready = false;

  pthread_mutex_lock(&g_ue_kpm_mtx);

  ue_kpm_state_t* s = get_or_create_ue_state(ue_id);
  if (ue_metrics_ready(s)) {
    if (volume_dl) *volume_dl = s->volume_dl;
    if (pacotes_dl) *pacotes_dl = s->pacotes_dl;
    if (bitrate_dl_kbps) *bitrate_dl_kbps = s->bitrate_dl_kbps;
    if (delay_dl_us) *delay_dl_us = s->delay_dl_us;

    reset_ue_metric_flags(s);
    ready = true;
  }

  pthread_mutex_unlock(&g_ue_kpm_mtx);
  return ready;
}



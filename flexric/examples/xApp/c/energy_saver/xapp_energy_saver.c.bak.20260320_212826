bool print_decision_from_metrics(double pdcpBitrateDl, double pdcpDelayDl, int pdcpVolumeDl, int pdcpNbrDl, int device_idx)
{
  bool energy_save = false;
  char motivo[256] = {0};

  if (pdcpDelayDl >= (double)g_threshold_us) {
    printf("[XAPP-ENERGY] diagnostico      = LATENCIA_ALTA (%.0f us >= %.0f us threshold)\n", pdcpDelayDl, (double)g_threshold_us);
    printf("[XAPP-ENERGY] acao             = INTERVENTION_PENDING\n");
    return false;
  }

  // Threshold ENERGY_SAVE: 25 Mbps (25000 kbps) conforme cenário realista
  if (pdcpBitrateDl >= 0.0 && pdcpBitrateDl < 25000.0) {
    energy_save = true;
    strcat(motivo, "BITRATE_BAIXO ");
  }

  if (pdcpNbrDl >= 0 && pdcpNbrDl <= 5) {
    energy_save = true;
    strcat(motivo, "POUCOS_PACOTES ");
  }

  if (pdcpVolumeDl >= 0 && pdcpVolumeDl < 100) {
    energy_save = true;
    strcat(motivo, "VOLUME_BAIXO ");
  }

  if (energy_save) {
    printf("[XAPP-ENERGY] diagnostico      = %s\n", motivo);
    printf("[XAPP-ENERGY] acao             = ENERGY_SAVE\n");
    g_send_control = true;
    return true;
  }

  printf("[XAPP-ENERGY] diagnostico      = CARGA_NORMAL\n");
  printf("[XAPP-ENERGY] acao             = MANTER_NORMAL\n");
  return false;
}
static
void log_kpm_measurements(kpm_ind_msg_format_1_t const* msg_frm_1, ue_id_e2sm_t const* ue_id)
{
  assert(msg_frm_1->meas_info_lst_len > 0 && "Cannot correctly print measurements");

  // Track unique UEs by their amf_ue_ngap_id - persistent across all messages
  // This tracks ALL unique UEs seen during the entire simulation
  static uint64_t displayed_ues[100] = {0};
  static int displayed_count = 0;
  
  // Get UE identifier
  uint64_t ue_identifier = 0;
  if (ue_id != NULL && ue_id->type == GNB_UE_ID_E2SM) {
    ue_identifier = ue_id->gnb.amf_ue_ngap_id;
  }
  
  if (ue_identifier == 0) {
    return; // Skip invalid UE IDs
  }
  
  // Check if we've already displayed this UE
  bool already_displayed = false;
  int ue_index = -1;
  for (int i = 0; i < displayed_count && i < 100; i++) {
    if (displayed_ues[i] == ue_identifier) {
      already_displayed = true;
      ue_index = i;
      break;
    }
  }
  
  // If not displayed yet and we have room, add it
  if (!already_displayed && displayed_count < 100 && ue_identifier > 0) {
    displayed_ues[displayed_count] = ue_identifier;
    ue_index = displayed_count;
    displayed_count++;
  } else if (!already_displayed && displayed_count >= 100) {
    // Too many UEs, skip
    return;
  }
  
    // Determine device type and number based on index
  const char* device_type;
  int device_num;
  
  if (ue_index >= 0 && ue_index < 3) {
    // First 3 UEs are cameras
    device_type = "CAMERA";
    device_num = ue_index + 1;
  } else if (ue_index >= 3 && ue_index < 13) {
    // UEs 4-13 are regular UEs (10 total)
    device_type = "UE";
    device_num = ue_index - 2;  // UE1 = index 3, so 3-2=1
  } else if (ue_index >= 13) {
    // More than 13 devices - skip display
    return;
  } else {
    // Invalid index - skip
    return;
  }

  bool saw_interesting_metric = false;
  bool saw_cell_level_metric = false;
  bool has_volume = false;
  bool has_pkts = false;
  bool has_bitrate = false;
  bool has_delay = false;

  long agg_volume = -1;
  long agg_pkts = -1;
  double agg_bitrate = -1.0;
  double agg_delay = -1.0;

  size_t lim = msg_frm_1->meas_data_lst_len < msg_frm_1->meas_info_lst_len ?
               msg_frm_1->meas_data_lst_len : msg_frm_1->meas_info_lst_len;

  // Debug: print all metric names received
  printf("[XAPP-ENERGY] DEBUG: Received %zu metrics:\n", lim);
  for (size_t j = 0; j < lim && j < 10; j++) {
    meas_type_t const meas_type = msg_frm_1->meas_info_lst[j].meas_type;
    if (meas_type.type == NAME_MEAS_TYPE && meas_type.name.buf != NULL) {
      char meas_name[256] = {0};
      size_t n = meas_type.name.len < sizeof(meas_name) - 1 ? meas_type.name.len : sizeof(meas_name) - 1;
      memcpy(meas_name, meas_type.name.buf, n);
      meas_name[n] = '\0';
      
      meas_data_lst_t const data_item = msg_frm_1->meas_data_lst[j];
      long val = -1;
      if (data_item.meas_record_len > 0) {
        if (data_item.meas_record_lst[0].value == INTEGER_MEAS_VALUE)
          val = (long)data_item.meas_record_lst[0].int_val;
        else if (data_item.meas_record_lst[0].value == REAL_MEAS_VALUE)
          val = (long)data_item.meas_record_lst[0].real_val;
      }
      printf("[XAPP-ENERGY] DEBUG:   - %s = %ld\n", meas_name, val);
    }
  }

  for (size_t j = 0; j < lim; j++) {
    meas_data_lst_t const data_item = msg_frm_1->meas_data_lst[j];
    meas_type_t const meas_type = msg_frm_1->meas_info_lst[j].meas_type;

    if (meas_type.type != NAME_MEAS_TYPE)
      continue;

    if (data_item.meas_record_len == 0)
      continue;

    meas_record_lst_t const record_item = data_item.meas_record_lst[0];

    char meas_name[256] = {0};
    size_t n = meas_type.name.len < sizeof(meas_name) - 1 ? meas_type.name.len : sizeof(meas_name) - 1;
    memcpy(meas_name, meas_type.name.buf, n);
    meas_name[n] = '\0';

    // Handle both PDCP and RLC metrics with various prefixes
    // PDCP metrics: PdcpSduVolumeDl, PdcpSduNbrDl, PdcpSduBitRateDl, PdcpSduDelayDl
    // May have prefixes like DRB., Tot., or suffixes like _Filter
    // Also handle cell-level metrics: DRB.EstabSucc.5QI, DRB.RelActNbr.5QI
    
    if (strstr(meas_name, "VolumeDl") != NULL || strstr(meas_name, "PdcpSduVolumeDl") != NULL) {
      if (record_item.value == INTEGER_MEAS_VALUE)
        agg_volume = (long)record_item.int_val;
      else if (record_item.value == REAL_MEAS_VALUE)
        agg_volume = (long)record_item.real_val;

      has_volume = true;
      saw_interesting_metric = true;

    } else if (strstr(meas_name, "NbrDl") != NULL || strstr(meas_name, "PdcpSduNbrDl") != NULL) {
      if (record_item.value == INTEGER_MEAS_VALUE)
        agg_pkts = (long)record_item.int_val;
      else if (record_item.value == REAL_MEAS_VALUE)
        agg_pkts = (long)record_item.real_val;

      has_pkts = true;
      saw_interesting_metric = true;

    } else if (strstr(meas_name, "BitRateDl") != NULL || strstr(meas_name, "PdcpSduBitRateDl") != NULL) {
      if (record_item.value == REAL_MEAS_VALUE)
        agg_bitrate = (double)record_item.real_val;
      else if (record_item.value == INTEGER_MEAS_VALUE)
        agg_bitrate = (double)record_item.int_val;

      has_bitrate = true;
      saw_interesting_metric = true;

    } else if (strstr(meas_name, "DelayDl") != NULL || strstr(meas_name, "PdcpSduDelayDl") != NULL) {
      if (record_item.value == REAL_MEAS_VALUE)
        agg_delay = (double)record_item.real_val;
      else if (record_item.value == INTEGER_MEAS_VALUE)
        agg_delay = (double)record_item.int_val;

      has_delay = true;
      saw_interesting_metric = true;
    } else if (strstr(meas_name, "EstabSucc.5QI") != NULL) {
      // Cell-level: DRB Establishment Successful (informational only)
      saw_cell_level_metric = true;
      saw_interesting_metric = true;
    } else if (strstr(meas_name, "RelActNbr.5QI") != NULL) {
      // Cell-level: DRB Release Activity Neighbor (informational only)
      saw_cell_level_metric = true;
      saw_interesting_metric = true;
    }
  }

  if (!saw_interesting_metric) {
    // Only informational cell-level metrics received - not an error, just skip
    return;
  }

  if (!(has_volume && has_pkts && has_bitrate && has_delay)) {
    printf("[XAPP-ENERGY] %s %d -> KPM_INCOMPLETO\n", device_type, device_num);
    return;
  }

  double pdcpBitrateDl = agg_bitrate;
  double pdcpDelayDl = agg_delay;
  int pdcpVolumeDl = (int)agg_volume;
  int pdcpNbrDl = (int)agg_pkts;

  printf("[XAPP-ENERGY] ===== %s %d =====\n", device_type, device_num);
  printf("[XAPP-ENERGY] volume_dl        = %d\n", pdcpVolumeDl);
  printf("[XAPP-ENERGY] pacotes_dl       = %d\n", pdcpNbrDl);
  printf("[XAPP-ENERGY] bitrate_dl_kbps  = %.2f\n", pdcpBitrateDl);
  printf("[XAPP-ENERGY] delay_dl_us      = %.2f\n", pdcpDelayDl);

  if (pdcpDelayDl >= (double)g_threshold_us) {
    printf("[XAPP-ENERGY] problema_principal = LATENCIA (%.0f us >= %.0f us)\n", pdcpDelayDl, (double)g_threshold_us);
  } else if (pdcpNbrDl >= 0 && pdcpNbrDl <= 5) {
    printf("[XAPP-ENERGY] problema_principal = BAIXA_CARGA\n");
  } else if (pdcpBitrateDl >= 0.0 && pdcpBitrateDl < 1000.0) {
    printf("[XAPP-ENERGY] problema_principal = BAIXA_CARGA\n");
  } else if (pdcpVolumeDl >= 0 && pdcpVolumeDl < 100) {
    printf("[XAPP-ENERGY] problema_principal = BAIXA_CARGA\n");
  } else {
    printf("[XAPP-ENERGY] problema_principal = NENHUM\n");
  }

  print_decision_from_metrics(pdcpBitrateDl, pdcpDelayDl, pdcpVolumeDl, pdcpNbrDl, ue_index);

  if (g_xapp_state.control_enabled && is_camera_ue(ue_index)) {
    if (pdcpDelayDl > INTERVENTION_LATENCY_US && pdcpBitrateDl < INTERVENTION_BITRATE_KBPS) {
      printf("\n");
      printf("========================================\n");
      printf("[XAPP-ENERGY] *** URGENTE: CAMERA %d CRITICA ***\n", device_num);
      printf("[XAPP-ENERGY] Latencia: %.0fus > 100ms EUX bitrate: %.0fkbps < 25Mbps\n",
             pdcpDelayDl, pdcpBitrateDl);
      printf("[XAPP-ENERGY] Acao: CELL_ON IMEDIATO\n");
      printf("========================================\n");
      pthread_mutex_lock(&g_immediate_mtx);
      g_immediate_action_pending = true;
      g_immediate_cell_idx = ue_index;
      g_immediate_ue_id = ue_identifier;
      g_immediate_cell_id = ue_index + 1;
      pthread_mutex_unlock(&g_immediate_mtx);
    }
  }
  
  if (g_xapp_state.control_enabled) {
    // Find or allocate a cell slot for this UE
    // Map each unique UE to a fixed cell slot (persistent across messages)
    int cell_idx = -1;
    
    // First: check if we already have this UE mapped
    for (int i = 0; i < MAX_CELLS; i++) {
      if (g_xapp_state.cells[i].has_valid_ue && 
          g_xapp_state.cells[i].ue_id == ue_identifier) {
        cell_idx = i;
        break;
      }
    }
    
    // Second: if not found, allocate a new slot
    if (cell_idx < 0) {
      for (int i = 0; i < MAX_CELLS; i++) {
        if (!g_xapp_state.cells[i].has_valid_ue) {
          cell_idx = i;
          g_xapp_state.cells[cell_idx].cell_id = i + 1;
          g_xapp_state.num_cells++;
          printf("[XAPP-ENERGY] INFO: Novo UE %lu mapeado para Celula %d\n", ue_identifier, cell_idx + 1);
          break;
        }
      }
    }
    
    if (cell_idx >= 0) {
      update_cell_state(cell_idx, ue_identifier, pdcpDelayDl, pdcpBitrateDl, pdcpVolumeDl);
    }
  }
}


static
void sm_cb_kpm(sm_ag_if_rd_t const* rd)
{
  assert(rd != NULL);
  assert(rd->type == INDICATION_MSG_AGENT_IF_ANS_V0);
  assert(rd->ind.type == KPM_STATS_V3_0);

  // Reading Indication Message Format 3
  kpm_ind_data_t const* ind = &rd->ind.kpm.ind;
  kpm_ric_ind_hdr_format_1_t const* hdr_frm_1 = &ind->hdr.kpm_ric_ind_hdr_format_1;
  kpm_ind_msg_format_3_t const* msg_frm_3 = &ind->msg.frm_3;

  int64_t const now = time_now_us();
  static int counter = 1;
  {
    lock_guard(&mtx);
    printf("[XAPP-ENERGY] \n%7d KPM ind_msg latency = %ld [μs]\n", counter, now - hdr_frm_1->collectStartTime); // xApp <-> E2 Node


    // Reported list of measurements per UE
    for (size_t i = 0; i < msg_frm_3->ue_meas_report_lst_len; i++) {
      // log UE ID
      ue_id_e2sm_t const ue_id_e2sm = msg_frm_3->meas_report_per_ue[i].ue_meas_report_lst;
      ue_id_e2sm_e const type = ue_id_e2sm.type;
      log_ue_id_e2sm[type](ue_id_e2sm);
      // Save UE ID for filling RC Control message
      free_ue_id_e2sm(&ue_id);
      ue_id = cp_ue_id_e2sm(&ue_id_e2sm);

      // log measurements
      log_kpm_measurements(&msg_frm_3->meas_report_per_ue[i].ind_msg_format_1, &ue_id_e2sm);
      
    }
    counter++;
  }
}


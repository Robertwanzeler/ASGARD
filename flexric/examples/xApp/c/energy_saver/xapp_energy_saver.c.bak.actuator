/*
 * GreenRAN O-RAN - xApp ENERGY SAVER
 * 
 * Responsabilidade: Gerenciamento de desligamento seletivo de células
 * - Detecta baixa utilização de RUs e mmWave layers
 * - Desliga RUs/mmWave layers ociosos para economia de energia
 * - Quando SLICER está CRITICAL, NÃO atua (SLA tem prioridade)
 * 
 * Interface para rApp: /tmp/xapp_intents/energy_saver.txt
 * 
 * Regras de Decisão:
 * - Latência > 100ms → INTERVENTION (bloquear desligamento)
 * - Baixa utilização E rApp permite → ENERGY_SAVE
 * - Caso contrário → NORMAL
 * 
 * Ações de Controle:
 * - ENERGY_SAVE: CELL_OFF para RUs ociosos, desligar mmWave layers
 * - INTERVENTION: Manter todos os recursos ativos
 * - NORMAL: Manter operação padrão
 */

#include "../../../../src/xApp/e42_xapp_api.h"
#include "../../../../src/sm/rc_sm/ie/ir/ran_param_struct.h"
#include "../../../../src/sm/rc_sm/ie/ir/ran_param_list.h"
#include "../../../../src/sm/rc_sm/rc_sm_id.h"
#include "../../../../src/util/time_now_us.h"
#include "../../../../src/util/alg_ds/ds/lock_guard/lock_guard.h"
#include "../../../../src/util/e.h"
#include <stdlib.h>
#include <stdio.h>
#include <time.h>
#include <unistd.h>
#include <pthread.h>
#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#include <errno.h>
#include <signal.h>
#include <sys/wait.h>
#include <sys/time.h>

/*******************************************************************************
 * CONFIGURAÇÕES
 ******************************************************************************/
#define CONTROL_LOOP_INTERVAL_MS      500     // 500ms para Near-RT RIC
#define METRICS_FILE_PATH        "/tmp/xapp_metrics/metrics.json"
#define METRICS_POLL_INTERVAL_MS      200     // 200ms polling para métricas
#define RAPP_DECISION_PATH    "/tmp/xapp_intents/rapp_decision.txt"

// Thresholds
#define INTERVENTION_THRESHOLD_US   80000   // 80ms - INTERVENTION (GREENRAN: ajustado)
#define ENERGY_SAVE_LATENCY_US     10000   // 10ms - baixa latência

/*******************************************************************************
 * ESTADOS DO ENERGY SAVER
 ******************************************************************************/
typedef enum {
    INTENT_NORMAL = 0,
    INTENT_INTERVENTION = 1,     // Não desligar - SLA priority
    INTENT_ENERGY_SAVE = 2       // Pode desligar RUs
} xapp_intent_e;

/*******************************************************************************
 * AÇÕES DE CONTROLE DO ENERGY SAVER
 ******************************************************************************/
typedef enum {
    EACTION_NONE = 0,
    EACTION_CELL_OFF = 1,            // Desligar RU
    EACTION_MMWAVE_OFF = 2,          // Desligar mmWave layer
    EACTION_REDUCE_POWER = 3,        // Reduzir potência
    EACTION_MAINTAIN_ALL = 4,        // Manter todos ativos
    EACTION_RESTORE = 5              // Restaurar recursos
} energy_action_e;

static const char* intent_to_string(xapp_intent_e intent)
{
    switch (intent) {
        case INTENT_NORMAL:       return "NORMAL";
        case INTENT_INTERVENTION: return "INTERVENTION";
        case INTENT_ENERGY_SAVE:  return "ENERGY_SAVE";
        default:                 return "UNKNOWN";
    }
}

static const char* intent_to_color(xapp_intent_e intent)
{
    switch (intent) {
        case INTENT_INTERVENTION: return "\033[1;31m";  // Vermelho brilhante
        case INTENT_ENERGY_SAVE:  return "\033[1;32m";  // Verde brilhante
        case INTENT_NORMAL:       return "\033[1;36m";  // Ciano brilhante
        default:                 return "\033[0m";
    }
}

#define COLOR_RESET "\033[0m"

static const char* action_to_string(energy_action_e action)
{
    switch (action) {
        case EACTION_NONE:          return "NONE";
        case EACTION_CELL_OFF:      return "CELL_OFF";
        case EACTION_MMWAVE_OFF:   return "MMWAVE_OFF";
        case EACTION_REDUCE_POWER: return "REDUCE_POWER";
        case EACTION_MAINTAIN_ALL:  return "MAINTAIN_ALL";
        case EACTION_RESTORE:      return "RESTORE";
        default:                   return "UNKNOWN";
    }
}

/*******************************************************************************
 * ESTADO GLOBAL DO ENERGY SAVER
 ******************************************************************************/
static struct {
    xapp_intent_e current_intent;
    xapp_intent_e previous_intent;
    energy_action_e current_action;
    uint64_t last_state_change;
    bool rapp_blocked;
    bool running;
    int intervention_count;
    int energy_save_count;
    int restore_count;
    FILE* intent_file;
    double worst_latency_us;
    double p95_latency_us;       // P95 - métrica mais robusta
    int active_cameras;
    int ru_active_count;
    int mmwave_active_count;
} g_xapp_state = {0};

static pthread_mutex_t g_mtx = PTHREAD_MUTEX_INITIALIZER;
static pthread_mutex_t g_json_mtx = PTHREAD_MUTEX_INITIALIZER;

/*******************************************************************************
 * INTERFACE PARA rApp
 ******************************************************************************/
#define INTENT_FILE_PATH "/tmp/xapp_intents/energy_saver.txt"

static bool is_rapp_allowing_action(void)
{
    FILE* f = fopen(RAPP_DECISION_PATH, "r");
    if (!f) return true;
    
    char line[256];
    while (fgets(line, sizeof(line), f)) {
        if (strstr(line, "energy_saver") && strstr(line, "BLOCKED")) {
            fclose(f);
            return false;
        }
    }
    fclose(f);
    return true;
}

static void write_intent_to_file(xapp_intent_e intent, energy_action_e action, double p95_latency_us)
{
    if (g_xapp_state.intent_file) {
        rewind(g_xapp_state.intent_file);
        time_t now = time(NULL);
        
        const char* intent_str = intent_to_string(intent);
        const char* act_str = action_to_string(action);
        
        double latency_ms = p95_latency_us / 1000.0;
        
        const char* intent_desc = "";
        if (intent == INTENT_INTERVENTION) {
            intent_desc = "SLA violado - mantendo todos ativos";
        } else if (intent == INTENT_ENERGY_SAVE) {
            intent_desc = "Oportunidade para economia de energia";
        } else {
            intent_desc = "Operacao normal";
        }
        
        const char* blocked_desc = g_xapp_state.rapp_blocked ? "SIM (por rApp)" : "NAO";
        
        fprintf(g_xapp_state.intent_file,
                "================================================================\n"
                "                 xApp ENERGY SAVER - Intent\n"
                "================================================================\n"
                "\n"
                "STATUS:\n"
                "  Intencao: %s\n"
                "  Descricao: %s\n"
                "\n"
                "METRICAS:\n"
                "  Latencia: %.0f us (%.1f ms)\n"
                "  Cameras ativas: %d\n"
                "  RUs ativos: %d\n"
                "  mmWave ativo: %d\n"
                "\n"
                "rApp STATUS:\n"
                "  Energy Saver bloqueado: %s\n"
                "\n"
                "ACAO:\n"
                "  Comando: %s\n"
                "\n"
                "================================================================\n"
                "\n"
                "XAPP=energy_saver\n"
                "INTENT=%s\n"
                "ACTION=%s\n"
                "TIMESTAMP=%ld\n"
                "WORST_LATENCY_US=%.0f\n"
                "ACTIVE_CAMERAS=%d\n"
                "RU_ACTIVE=%d\n"
                "MMWAVE_ACTIVE=%d\n"
                "RAPP_BLOCKED=%s\n",
                intent_str,
                intent_desc,
                g_xapp_state.worst_latency_us,
                latency_ms,
                g_xapp_state.active_cameras,
                g_xapp_state.ru_active_count,
                g_xapp_state.mmwave_active_count,
                blocked_desc,
                act_str,
                intent_str,
                act_str,
                (long)now,
                g_xapp_state.worst_latency_us,
                g_xapp_state.active_cameras,
                g_xapp_state.ru_active_count,
                g_xapp_state.mmwave_active_count,
                g_xapp_state.rapp_blocked ? "yes" : "no");
        fflush(g_xapp_state.intent_file);
    }
}

static void init_intent_file(void)
{
    system("mkdir -p /tmp/xapp_intents");
    g_xapp_state.intent_file = fopen(INTENT_FILE_PATH, "w");
    if (!g_xapp_state.intent_file) {
        fprintf(stderr, "[XAPP-ENERGY] WRN: Não foi possível criar %s\n", INTENT_FILE_PATH);
    }
}

static void close_intent_file(void)
{
    if (g_xapp_state.intent_file) {
        fclose(g_xapp_state.intent_file);
        g_xapp_state.intent_file = NULL;
    }
}

/*******************************************************************************
 * JSON PARSING
 ******************************************************************************/

static int parse_json_file(const char* filepath,
                           double* worst_latency,
                           double* p95_latency,
                           int* active_cameras)
{
    FILE* f = fopen(filepath, "r");
    if (!f) {
        return -1;
    }
    
    pthread_mutex_lock(&g_json_mtx);
    
    char buffer[65536];
    size_t bytes_read = fread(buffer, 1, sizeof(buffer) - 1, f);
    buffer[bytes_read] = '\0';
    
    fclose(f);
    pthread_mutex_unlock(&g_json_mtx);
    
    *worst_latency = 0;
    *p95_latency = 0;
    *active_cameras = 0;
    
    char* ptr = buffer;
    while (*ptr) {
        if (strstr(ptr, "\"global_worst_latency_us\"") != NULL) {
            char* colon = strchr(ptr, ':');
            if (colon) {
                *worst_latency = atof(colon + 1);
            }
        }
        if (strstr(ptr, "\"latency_p95_us\"") != NULL) {
            char* colon = strchr(ptr, ':');
            if (colon) {
                *p95_latency = atof(colon + 1);
            }
        }
        if (strstr(ptr, "\"active_cameras\"") != NULL) {
            char* colon = strchr(ptr, ':');
            if (colon) {
                *active_cameras = atoi(colon + 1);
            }
        }
        ptr++;
    }
    
    return 0;
}

/*******************************************************************************
 * DECISÃO DE CONTROLE
 ******************************************************************************/
static xapp_intent_e evaluate_decision(double worst_latency_us, double p95_latency_us, int active_cameras, bool rapp_allows)
{
    // Usar P95 se disponível (mais robusto), senão fallback para worst
    double latency_us = (p95_latency_us > 0) ? p95_latency_us : worst_latency_us;
    
    // Se latência muito alta, NÃO desligar nada
    if (latency_us >= INTERVENTION_THRESHOLD_US) {
        return INTENT_INTERVENTION;
    }
    
    // Se rApp bloqueou, não agir
    if (!rapp_allows) {
        return INTENT_NORMAL;
    }
    
    // Se sem câmeras ativas e baixa latência, pode economizar
    if (active_cameras == 0 && latency_us < ENERGY_SAVE_LATENCY_US) {
        return INTENT_ENERGY_SAVE;
    }
    
    // Caso contrário, manter operação normal
    return INTENT_NORMAL;
}

static energy_action_e evaluate_action(xapp_intent_e intent, bool rapp_allows)
{
    switch (intent) {
        case INTENT_INTERVENTION:
            // Manter tudo ativo
            return EACTION_MAINTAIN_ALL;
            
        case INTENT_ENERGY_SAVE:
            if (!rapp_allows) {
                return EACTION_MAINTAIN_ALL;
            }
            // Pode desligar RUs/mmWave
            return EACTION_MMWAVE_OFF;
            
        case INTENT_NORMAL:
        default:
            // Verificar se precisa restaurar
            if (g_xapp_state.current_action == EACTION_MMWAVE_OFF && !rapp_allows) {
                return EACTION_RESTORE;
            }
            return EACTION_NONE;
    }
}

/*******************************************************************************
 * AÇÃO DE CONTROLE - Desligamento de RUs
 ******************************************************************************/
static void send_energy_control(energy_action_e action, double latency)
{
    switch (action) {
        case EACTION_CELL_OFF:
            printf("\033[1;36m      - Details: \033[0mDesligar RU ocioso\n");
            break;
            
        case EACTION_MMWAVE_OFF:
            printf("\033[1;36m      - Details: \033[0mDesligar mmWave layer\n");
            break;
            
        case EACTION_REDUCE_POWER:
            printf("\033[1;36m      - Details: \033[0mReduzir potência TX\n");
            break;
            
        case EACTION_MAINTAIN_ALL:
            printf("\033[1;36m      - Details: \033[0mManter todos os recursos ativos\n");
            break;
            
        case EACTION_RESTORE:
            printf("\033[1;36m      - Details: \033[0mRestaurando mmWave layer...\n");
            break;
            
        default:
            break;
    }
}

/*******************************************************************************
 * JSON MONITOR THREAD
 ******************************************************************************/
static void* json_monitor_thread(void* arg)
{
    (void)arg;
    
    int cycle = 0;
    g_xapp_state.ru_active_count = 2;  // Simular 2 RUs ativos
    g_xapp_state.mmwave_active_count = 1;  // Simular 1 mmWave ativo
    
    while (g_xapp_state.running) {
        usleep(METRICS_POLL_INTERVAL_MS * 1000);
        cycle++;
        
        double worst_lat = 0;
        double p95_lat = 0;
        int active_cam = 0;
        
        int ret = parse_json_file(METRICS_FILE_PATH, &worst_lat, &p95_lat, &active_cam);
        
        if (ret == 0) {
            pthread_mutex_lock(&g_mtx);
            
            bool rapp_allows = is_rapp_allowing_action();
            xapp_intent_e new_intent = evaluate_decision(worst_lat, p95_lat, active_cam, rapp_allows);
            
            int new_ru = g_xapp_state.ru_active_count;
            int new_mmwave = g_xapp_state.mmwave_active_count;
            energy_action_e new_action = evaluate_action(new_intent, rapp_allows);
            
            // Simular desligamento
            if (new_intent == INTENT_ENERGY_SAVE && rapp_allows) {
                new_mmwave = 0;  // Desligar mmWave
                new_ru = 1;     // Manter 1 RU
            } else if (new_intent == INTENT_INTERVENTION || !rapp_allows) {
                new_ru = 2;
                new_mmwave = 1;
            }
            
            // Formatacao vertical mais clara
            printf("\n\033[1;33m[ENERGY-SAVER]\033[0m Cycle: %d\n", cycle);
            printf("  P95 Latency: %6.1f ms\n", p95_lat/1000.0);
            printf("  Cameras: %d\n", active_cam);
            printf("  rApp:    %s\n", rapp_allows ? "\033[1;32mALLOWED\033[0m" : "\033[1;31mBLOCKED\033[0m");
            
            // Verificar mudança
            if (new_intent != g_xapp_state.current_intent || new_action != g_xapp_state.current_action) {
                printf("\033[1;36m  => State Change: \033[0m%s -> %s\n",
                       intent_to_string(g_xapp_state.current_intent),
                       intent_to_string(new_intent));
                printf("\033[1;36m  => Executing Action: \033[1m%s\033[0m\n", action_to_string(new_action));
                
                // Executar ação
                send_energy_control(new_action, worst_lat);
                
                // Registrar contadores
                if (new_intent == INTENT_INTERVENTION && g_xapp_state.current_intent != INTENT_INTERVENTION) {
                    g_xapp_state.intervention_count++;
                }
                if (new_intent == INTENT_ENERGY_SAVE && g_xapp_state.current_intent != INTENT_ENERGY_SAVE) {
                    g_xapp_state.energy_save_count++;
                }
                if (new_action == EACTION_RESTORE) {
                    g_xapp_state.restore_count++;
                }
                
                g_xapp_state.previous_intent = g_xapp_state.current_intent;
                g_xapp_state.current_intent = new_intent;
                g_xapp_state.current_action = new_action;
                g_xapp_state.last_state_change = time(NULL);
                
                write_intent_to_file(new_intent, new_action, p95_lat);
            }
            
            g_xapp_state.worst_latency_us = worst_lat;
            g_xapp_state.p95_latency_us = p95_lat;
            g_xapp_state.active_cameras = active_cam;
            g_xapp_state.ru_active_count = new_ru;
            g_xapp_state.mmwave_active_count = new_mmwave;
            g_xapp_state.rapp_blocked = !rapp_allows;
            
            pthread_mutex_unlock(&g_mtx);
        } else if (cycle % 10 == 0) {
            printf("[XAPP-ENERGY-JSON] Aguardando arquivo de métricas... (cycle %d)\n", cycle);
        }
    }
    
    return NULL;
}

/*******************************************************************************
 * MAIN
 ******************************************************************************/
int main(int argc, char* argv[])
{
    fr_args_t args = init_fr_args(argc, argv);
    init_xapp_api(&args);
    
    printf("\n");
    printf("╔══════════════════════════════════════════════════════════╗\n");
    printf("║          ENERGY SAVER xApp - GreenRAN O-RAN         ║\n");
    printf("╠══════════════════════════════════════════════════════════╣\n");
    printf("║  Função: Desligamento seletivo de RUs/mmWave layers  ║\n");
    printf("║  Prioridade: SLA > Energy Saving                    ║\n");
    printf("╠══════════════════════════════════════════════════════════╣\n");
    printf("║  Thresholds:                                        ║\n");
    printf("║    INTERVENTION: latência > %d us (100ms)          ║\n", INTERVENTION_THRESHOLD_US);
    printf("║    ENERGY_SAVE: ativas=0 E lat < %d us            ║\n", ENERGY_SAVE_LATENCY_US);
    printf("╠══════════════════════════════════════════════════════════╣\n");
    printf("║  Ações de Controle:                                  ║\n");
    printf("║    ENERGY_SAVE: Desligar mmWave, manter 1 RU        ║\n");
    printf("║    INTERVENTION: Manter todos os recursos ativos     ║\n");
    printf("║    RESTORE: Restaurar mmWave layer                  ║\n");
    printf("╚══════════════════════════════════════════════════════════╝\n\n");
    
    g_xapp_state.current_intent = INTENT_NORMAL;
    g_xapp_state.current_action = EACTION_MAINTAIN_ALL;
    g_xapp_state.running = true;
    g_xapp_state.rapp_blocked = false;
    init_intent_file();
    
    system("mkdir -p /tmp/xapp_metrics");
    
    pthread_t json_thread;
    if (pthread_create(&json_thread, NULL, json_monitor_thread, NULL) != 0) {
        fprintf(stderr, "[XAPP-ENERGY] ERRO: Falha ao criar thread\n");
        return 1;
    }
    
    printf("[XAPP-ENERGY] Thread de monitoramento iniciada\n");
    
    uint64_t start_time = time_now_us();
    int cycle = 0;
    
    while (g_xapp_state.running) {
        usleep(CONTROL_LOOP_INTERVAL_MS * 1000);
        cycle++;
        uint64_t elapsed = (time_now_us() - start_time) / 1000000;
        
        pthread_mutex_lock(&g_mtx);
        xapp_intent_e current_intent = g_xapp_state.current_intent;
        energy_action_e current_action = g_xapp_state.current_action;
        double worst_lat = g_xapp_state.worst_latency_us;
        int active = g_xapp_state.active_cameras;
        int ru = g_xapp_state.ru_active_count;
        int mmwave = g_xapp_state.mmwave_active_count;
        bool blocked = g_xapp_state.rapp_blocked;
        int interventions = g_xapp_state.intervention_count;
        int energy_saves = g_xapp_state.energy_save_count;
        int restores = g_xapp_state.restore_count;
        pthread_mutex_unlock(&g_mtx);
        
        const char* intent_color = intent_to_color(current_intent);
        
        printf("\n");
        printf("================================================================\n");
        printf("                   xApp ENERGY SAVER\n");
        printf("================================================================\n");
        printf("\n");
        printf("  Intencao: %s[%s]%s\n", intent_color, intent_to_string(current_intent), COLOR_RESET);
        
        if (current_intent == INTENT_INTERVENTION) {
            printf("  %s<- PROBLEMA: Latencia > 100ms (SLA Priority!)\033[0m\n", intent_color);
        } else if (current_intent == INTENT_ENERGY_SAVE) {
            printf("  %s<- Oportunidade para economia\033[0m\n", intent_color);
        } else {
            printf("  %s<- Operacao normal\033[0m\n", intent_color);
        }
        
        printf("\n");
        printf("  Metricas:\n");
        printf("    Latencia: %.0f us (%.1f ms)\n", worst_lat, worst_lat / 1000.0);
        printf("    Cameras ativas: %d\n", active);
        printf("    RUs ativos: %d | mmWave ativo: %d\n", ru, mmwave);
        printf("\n");
        printf("  rApp Status:\n");
        if (blocked) {
            printf("    \033[1;31m<- rApp BLOQUEOU economia de energia\033[0m\n");
        } else {
            printf("    \033[1;32m<- rApp permite economia de energia\033[0m\n");
        }
        
        printf("\n");
        printf("  Acao: %s\n", action_to_string(current_action));
        printf("\n");
        printf("  Estatisticas: Intervencoes=%d, EnergySaves=%d, Restores=%d\n", 
               interventions, energy_saves, restores);
        printf("================================================================\n");
        
        if (current_intent == INTENT_INTERVENTION) {
            printf("\033[1;31m>>> ATENCAO: SLA VIOLADO! Mantendo recursos ativos\033[0m\n");
            if (blocked) {
                printf("\033[1;33m>>> rApp BLOQUEOU acao de energy saving\033[0m\n");
            }
        }
        
        if (current_intent == INTENT_ENERGY_SAVE && !blocked) {
            printf("\033[1;32m>>> Oportunidade para ENERGY SAVING - Desligando mmWave\033[0m\n");
        }
        
        if (elapsed >= 600) {
            printf("[XAPP-ENERGY] Tempo máximo (600s). Encerrando...\n");
            g_xapp_state.running = false;
        }
    }
    
    printf("\n[XAPP-ENERGY] Finalizando...\n");
    
    pthread_join(json_thread, NULL);
    
    while (try_stop_xapp_api() == false) usleep(1000);
    
    close_intent_file();
    
    printf("\n╔══════════════════════════════════════════════════════════╗\n");
    printf("║          ENERGY SAVER xApp - FINALIZADO             ║\n");
    printf("╠══════════════════════════════════════════════════════════╣\n");
    printf("║  Intervenções: %d                                      ║\n", g_xapp_state.intervention_count);
    printf("║  Energy Saves: %d                                     ║\n", g_xapp_state.energy_save_count);
    printf("║  Restores: %d                                         ║\n", g_xapp_state.restore_count);
    printf("╚══════════════════════════════════════════════════════════╝\n");
    
    return 0;
}

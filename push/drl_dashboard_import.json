{
  "dashboard": {
    "id": 1,
    "uid": "drl-greenran",
    "title": "DRL - SBiLSTM + A3C",
    "tags": [
      "greenran",
      "drl"
    ],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "DRL CVaR Prediction",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "query": "SELECT time, cvar FROM drl_prediction ORDER BY time DESC",
            "datasourceId": 1
          }
        ]
      },
      {
        "id": 2,
        "title": "Latest Decision",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "query": "SELECT last(decision) as decision, last(power) as power FROM drl_prediction",
            "datasourceId": 1
          }
        ]
      },
      {
        "id": 3,
        "title": "Decision Count",
        "type": "bargauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "refId": "A",
            "query": "SELECT count(decision) as count FROM drl_prediction GROUP BY decision",
            "datasourceId": 1
          }
        ]
      },
      {
        "id": 4,
        "title": "Power Distribution",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "refId": "A",
            "query": "SELECT count(power) as power_count FROM drl_prediction GROUP BY power",
            "datasourceId": 1
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m"
      ]
    }
  }
}